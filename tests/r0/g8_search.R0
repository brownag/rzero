list(
  which_min_int_basic = which.min(c(5L, 3L, 1L, 1L, 4L)),
  which_max_int_basic = which.max(c(5L, 3L, 5L, 1L, 4L)),
  which_min_dbl_basic = which.min(c(5.5, 3.2, 1.1, 1.1, 4.4)),
  which_max_dbl_basic = which.max(c(5.5, 3.2, 5.5, 1.1, 4.4)),
  which_min_lgl = which.min(c(TRUE, FALSE, TRUE)),
  which_max_lgl = which.max(c(FALSE, TRUE, FALSE)),
  which_min_range = which.min(1:10),
  which_max_range = which.max(1:10),
  which_min_range_desc = which.min(10:1),
  which_max_range_desc = which.max(10:1),
  inf_which_min = which.min(c(Inf, -Inf, 0)),
  inf_which_max = which.max(c(Inf, -Inf, 0)),
  na_which_min = which.min(c(NA, 5, 2, NA, 2)),
  na_which_max = which.max(c(NA, 1, 5, 5, 2)),
  nan_which_min = which.min(c(NaN, 10, -5)),
  nan_which_max = which.max(c(NaN, 10, -5)),
  all_na_which_min = which.min(c(NA, NaN, NA_real_)),
  all_na_which_max = which.max(c(NA, NaN, NA_real_)),
  empty_which_min = which.min(numeric(0)),
  empty_which_max = which.max(integer(0)),
  bare_c_which_min = which.min(c()),
  bare_c_which_max = which.max(c())
)

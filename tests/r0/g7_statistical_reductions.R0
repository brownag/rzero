list(
  prod_basic_3 = prod(c(2, 3, 4)),
  prod_empty = prod(numeric(0)),
  prod_null = prod(c()),
  prod_int = prod(1L:4L),
  prod_all_true = prod(c(TRUE, TRUE, TRUE)),
  prod_has_false = prod(c(TRUE, FALSE, TRUE)),
  prod_na = prod(c(2, NA_real_, 4)),
  prod_na_rm = prod(c(2, NA_real_, 4), na.rm = TRUE),
  prod_all_na_rm = prod(c(NA_real_, NA_real_), na.rm = TRUE),
  prod_nan = prod(c(2, NaN, 4)),
  var_basic_3 = var(c(1, 2, 3)),
  var_basic_5 = var(c(1, 2, 3, 4, 5)),
  var_int = var(1L:5L),
  var_single = var(c(5)),
  var_empty = var(numeric(0)),
  var_na = var(c(1, NA_real_, 3)),
  var_na_rm = var(c(1, NA_real_, 3), na.rm = TRUE),
  var_single_na_rm = var(c(1, NA_real_), na.rm = TRUE),
  sd_basic_3 = sd(c(1, 2, 3)),
  sd_two = sd(c(1, 3)),
  sd_single = sd(c(5)),
  sd_empty = sd(numeric(0)),
  sd_na = sd(c(1, NA_real_, 3)),
  sd_na_rm = sd(c(1, NA_real_, 3), na.rm = TRUE),
  sd_single_na_rm = sd(c(1, NA_real_), na.rm = TRUE),
  median_odd_1 = median(c(1, 2, 100)),
  median_odd_2 = median(c(100, 1, 2)),
  median_even_1 = median(c(1, 2, 3, 4)),
  median_even_2 = median(c(4, 1, 3, 2)),
  median_single = median(c(42)),
  median_empty = median(numeric(0)),
  median_na = median(c(1, NA_real_, 3)),
  median_na_rm = median(c(1, NA_real_, 3), na.rm = TRUE),
  median_na_rm_even = median(c(1, 2, NA_real_, 10), na.rm = TRUE),
  median_na_rm_odd = median(c(1, 2, 3, NA_real_, 10), na.rm = TRUE),
  median_all_na_rm = median(c(NA_real_, NA_real_), na.rm = TRUE),
  median_nan = median(c(1, NaN, 3))
)

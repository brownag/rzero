list(
  is_finite_double_mixed = is.finite(c(1.0, 0.0, -0.0, Inf, -Inf, NaN, NA_real_)),
  is_finite_int_na = is.finite(c(1L, 0L, -1L, NA_integer_)),
  is_finite_lgl = is.finite(c(TRUE, FALSE, NA)),
  is_finite_chr_na = is.finite(c("a", "b", NA)),
  is_finite_range = is.finite(1:3),
  is_finite_c_empty = is.finite(c()),
  is_finite_numeric_empty = is.finite(numeric(0)),
  is_infinite_double_mixed = is.infinite(c(1.0, 0.0, -0.0, Inf, -Inf, NaN, NA_real_)),
  is_infinite_int_na = is.infinite(c(1L, 0L, -1L, NA_integer_)),
  is_infinite_lgl = is.infinite(c(TRUE, FALSE, NA)),
  is_infinite_chr_na = is.infinite(c("a", "b", NA)),
  is_infinite_range = is.infinite(1:3),
  is_infinite_c_empty = is.infinite(c()),
  is_infinite_numeric_empty = is.infinite(numeric(0)),
  any_na_dbl_no_na = anyNA(c(1.0, 2.0)),
  any_na_dbl_na = anyNA(c(1.0, NA_real_)),
  any_na_dbl_nan = anyNA(c(1.0, NaN)),
  any_na_int_no_na = anyNA(c(1L, 2L)),
  any_na_int_na = anyNA(c(1L, NA_integer_)),
  any_na_lgl_no_na = anyNA(c(TRUE, FALSE)),
  any_na_lgl_na = anyNA(c(TRUE, NA)),
  any_na_chr_no_na = anyNA(c("a", "b")),
  any_na_chr_na = anyNA(c("a", NA)),
  any_na_range = anyNA(1:10),
  any_na_logical_empty = anyNA(logical(0)),
  any_na_c_empty = anyNA(c())
)

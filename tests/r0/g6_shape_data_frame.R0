df_regular <- data.frame(a = 1:5, b = c(10, 20, 30, 40, 50))
df_empty <- data.frame()
list(
  regular_nrow = nrow(df_regular),
  regular_ncol = ncol(df_regular),
  empty_nrow = nrow(df_empty),
  empty_ncol = ncol(df_empty),
  range_nrow = nrow(1:5),
  range_ncol = ncol(1:5),
  double_nrow = nrow(c(1.0, 2.0)),
  double_ncol = ncol(c(1.0, 2.0)),
  string_nrow = nrow(c("a", "b")),
  null_ncol = ncol(c()),
  null_nrow = nrow(c()),
  list_nrow = nrow(list(a = 1:3)),
  list_ncol = ncol(list(a = 1:3))
)

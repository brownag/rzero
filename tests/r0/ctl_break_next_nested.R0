s1 <- 0
for (i in 1:10) {
  if (i > 3) break
  s1 <- s1 + i
}
s2 <- 0
for (i in 1:5) {
  if (i == 2) next
  s2 <- s2 + i
}
i3 <- 0
while (TRUE) {
  i3 <- i3 + 1
  if (i3 >= 4) break
}
i4 <- 0
s4 <- 0
while (i4 < 5) {
  i4 <- i4 + 1
  if (i4 == 3) next
  s4 <- s4 + i4
}
n5 <- 0
for (i in 1:3) {
  for (j in 1:5) {
    if (j > 2) break
    n5 <- n5 + 1
  }
}
list(s1 = s1, s2 = s2, i3 = i3, s4 = s4, n5 = n5)

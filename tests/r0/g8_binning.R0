list(
  tabulate_dbl_default = tabulate(c(1, 2, 2, 5)),
  tabulate_int_default = tabulate(c(1L, 2L, 2L, 5L)),
  tabulate_range_default = tabulate(1:5),
  tabulate_dbl_truncate = tabulate(c(1.2, 2.8)),
  tabulate_nbins_named = tabulate(c(1, 2, 2, 5), nbins = 3),
  tabulate_nbins_positional = tabulate(c(1, 2, 2, 5), 3),
  tabulate_nbins_pad = tabulate(c(1, 2), nbins = 5),
  tabulate_nbins_zero = tabulate(c(1, 2), nbins = 0),
  tabulate_ignore_nonpositive_na = tabulate(c(-1, 0, NA, 2, 3)),
  tabulate_all_ignored = tabulate(c(-1, 0, NA)),
  tabulate_all_zero = tabulate(c(0, 0)),
  tabulate_integer0 = tabulate(integer(0)),
  find_interval_standard = findInterval(c(0, 1, 2.5, 3, 5, 10), c(1, 2, 3, 5)),
  find_interval_ties = findInterval(c(1, 2, 2.5, 5), c(1, 2, 2, 5)),
  find_interval_single_vec = findInterval(c(0, 1, 2, 3), c(2)),
  find_interval_range_x = findInterval(1:5, c(2, 4)),
  find_interval_lgl_x = findInterval(c(TRUE, FALSE), c(0, 1)),
  find_interval_empty_vec = findInterval(c(1, 2), c()),
  find_interval_empty_x = findInterval(c(), c(1, 2, 3)),
  find_interval_na_x = findInterval(c(NA, 1, 2, NA), c(1, 2, 3)),
  find_interval_na_x_empty_vec = findInterval(c(NA, 1), c())
)
